          "hooks": [
            {
              "type": "command",
              "command": "python -m spec_driven.adapters.claude_code_hook"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "matcher": "",
          "hooks": [
            {
              "type": "command",
              "command": "python -m spec_driven.adapters.claude_code_hook"
            }
          ]
        }
      ]
    }
  }
}
