  "skill_source": "skills/spec-driven-development",
  "skill_target": ".claude/skills/spec-driven-development",
  "settings_target": ".claude/settings.json",
  "settings_fragment": {
    "hooks": {
      "SessionStart": [
        {
          "matcher": "",
          "hooks": [
            {
              "type": "command",
              "command": "python -m spec_driven.adapters.claude_code_hook"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash",
